{
  "name": "@sd-design/sd-vue-docs",
  "version": "0.0.1",
  "private": true,
  "description": "SD Design 文档站",
  "type": "module",
  "scripts": {
    "dev": "pnpm run docs:vendor && astro dev --host --force",
    "dev:serve": "astro dev --host --force",
    "start": "pnpm run docs:vendor && astro dev --host --force",
    "build": "pnpm run build:site",
    "build:site": "pnpm run docs:vendor && astro build",
    "build:site:prepared": "astro build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vue-tsc.json && tsc --noEmit -p src/components/react/tsconfig.json",
    "pretest:dev": "pnpm run docs:pages",
    "test:dev": "node --test scripts/jsx-refresh.test.ts scripts/framework-navigation.test.ts scripts/framework-docs.test.ts scripts/livecodes.test.ts scripts/react-api.test.ts scripts/browser-chat.test.ts",
    "migrate:generated-demos": "node ./scripts/migrate-generated-demo-conventions.ts",
    "verify:theme-runtime": "node ./scripts/verify-theme-runtime-paths.ts",
    "preview": "pnpm run docs:vendor && astro preview",
    "astro": "astro",
    "docs:prepare": "pnpm --filter @sdata/web-vue run build:module && pnpm --filter @sdata/web-vue run build:dts && pnpm --filter @sdata/web-vue run jsongen && pnpm --filter @sdata/web-react build",
    "docs:pages": "node ./scripts/framework-docs.ts",
    "docs:check": "node ./scripts/framework-docs.ts --check",
    "docs:vendor": "pnpm run docs:prepare && pnpm run docs:vendor:only",
    "docs:vendor:only": "node ./scripts/sync-vendor.ts && node ./scripts/sync-react-vendor.ts && node ./scripts/sync-playground-types.ts && node ./scripts/sync-livecodes.ts"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.20",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/react": "^7.1.9",
    "@astrojs/starlight": "^0.43.1",
    "@astrojs/vue": "^7.1.6",
    "@mdx-js/mdx": "^3.1.1",
    "@mlc-ai/web-llm": "^0.2.89",
    "@oddbird/popover-polyfill": "0.7.3",
    "@sdata/web-react": "workspace:*",
    "@sdata/web-vue": "workspace:*",
    "@tailwindcss/vite": "^4.3.5",
    "@terrastruct/d2": "^0.1.33",
    "@vueuse/core": "catalog:",
    "astro": "^7.4.12",
    "katex": "^0.19.1",
    "livecodes": "^0.14.1",
    "mermaid": "^12.3.0",
    "motion-v": "^2.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.5",
    "unist-util-visit": "^5.2.0",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "rolldown": "^1.3.2",
    "tsdown": "catalog:",
    "vue-tsc": "^3.3.14"
  }
}
