{
  "name": "@sd-design/sd-vue-docs",
  "version": "0.0.1",
  "private": true,
  "description": "SD Design 文档站",
  "type": "module",
  "scripts": {
    "dev": "pnpm run docs:vendor && astro dev --host",
    "dev:serve": "astro dev --host",
    "start": "pnpm run docs:vendor && astro dev --host",
    "build": "pnpm run docs:vendor && astro build",
    "build:site": "astro build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vue-tsc.json",
    "migrate:generated-demos": "node ./scripts/migrate-generated-demo-conventions.mjs",
    "verify:theme-runtime": "node ./scripts/verify-theme-runtime-paths.mjs",
    "preview": "pnpm run docs:vendor && astro preview",
    "astro": "astro",
    "docs:prepare": "pnpm --filter @sdata/web-vue run build:module && pnpm --filter @sdata/web-vue run jsongen",
    "docs:vendor": "pnpm run docs:prepare && pnpm run docs:vendor:only",
    "docs:vendor:only": "node ./scripts/sync-vendor.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/starlight": "^0.41.7",
    "@astrojs/vue": "^7.0.2",
    "@sdata/web-vue": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@vue/repl": "^4.7.2",
    "@vueuse/core": "catalog:",
    "astro": "^7.2.1",
    "sharp": "^0.35.3",
    "shiki": "^4.4.2",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "rolldown": "^1.2.2",
    "vue-tsc": "^3.3.9"
  }
}
