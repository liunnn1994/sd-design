{
  "name": "@sd-design/sd-vue-docs",
  "version": "0.0.1",
  "private": true,
  "description": "SD Design 文档站",
  "type": "module",
  "scripts": {
    "dev": "pnpm run docs:vendor && astro dev --host --force",
    "dev:serve": "astro dev --host --force",
    "start": "pnpm run docs:vendor && astro dev --host --force",
    "build": "pnpm run docs:vendor && astro build",
    "build:site": "astro build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vue-tsc.json",
    "migrate:generated-demos": "node ./scripts/migrate-generated-demo-conventions.ts",
    "verify:theme-runtime": "node ./scripts/verify-theme-runtime-paths.ts",
    "preview": "pnpm run docs:vendor && astro preview",
    "astro": "astro",
    "docs:prepare": "pnpm --filter @sdata/web-vue run build:module && pnpm --filter @sdata/web-vue run jsongen",
    "docs:vendor": "pnpm run docs:prepare && pnpm run docs:vendor:only",
    "docs:vendor:only": "node ./scripts/sync-vendor.ts"
  },
  "dependencies": {
    "@antv/infographic": "0.2.20",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/starlight": "^0.42.4",
    "@astrojs/vue": "^7.0.3",
    "@sdata/web-vue": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@terrastruct/d2": "0.1.33",
    "@vue/repl": "^4.7.2",
    "@vueuse/core": "catalog:",
    "astro": "^7.3.5",
    "katex": "0.18.9",
    "mermaid": "12.0.0",
    "sharp": "^0.35.4",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "rolldown": "^1.2.9",
    "vue-tsc": "^3.3.11"
  }
}
