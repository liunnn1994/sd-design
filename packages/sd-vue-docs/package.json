{
  "name": "@sd-design/sd-vue-docs",
  "version": "0.0.1",
  "private": true,
  "description": "SD Design 文档站",
  "type": "module",
  "scripts": {
    "dev": "pnpm run docs:vendor && astro dev --host --force",
    "dev:serve": "astro dev --host --force",
    "start": "pnpm run docs:vendor && astro dev --host --force",
    "build": "pnpm run build:site",
    "build:site": "pnpm run docs:vendor && astro build",
    "build:site:prepared": "astro build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.vue-tsc.json && tsc --noEmit -p src/components/react/tsconfig.json",
    "test:dev": "node --test scripts/jsx-refresh.test.ts scripts/framework-navigation.test.ts scripts/framework-docs.test.ts scripts/react-repl.test.ts scripts/react-api.test.ts scripts/browser-chat.test.ts",
    "migrate:generated-demos": "node ./scripts/migrate-generated-demo-conventions.ts",
    "verify:theme-runtime": "node ./scripts/verify-theme-runtime-paths.ts",
    "preview": "pnpm run docs:vendor && astro preview",
    "astro": "astro",
    "docs:prepare": "pnpm --filter @sdata/web-vue run build:module && pnpm --filter @sdata/web-vue run jsongen && pnpm --filter @sdata/web-react build",
    "docs:pages": "node ./scripts/framework-docs.ts",
    "docs:check": "node ./scripts/framework-docs.ts --check",
    "docs:vendor": "pnpm run docs:prepare && pnpm run docs:vendor:only",
    "docs:vendor:only": "node ./scripts/sync-vendor.ts && node ./scripts/sync-react-vendor.ts"
  },
  "dependencies": {
    "@antv/infographic": "^0.2.20",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/react": "^7.1.2",
    "@astrojs/starlight": "^0.42.6",
    "@astrojs/vue": "^7.0.3",
    "@mdx-js/mdx": "^3.1.1",
    "@mlc-ai/web-llm": "^0.2.86",
    "@sdata/web-react": "workspace:*",
    "@sdata/web-vue": "workspace:*",
    "@tailwindcss/vite": "^4.3.3",
    "@terrastruct/d2": "^0.1.33",
    "@vue/repl": "^4.7.2",
    "@vueuse/core": "catalog:",
    "astro": "^7.3.8",
    "es-module-lexer": "^3.0.4",
    "katex": "^0.19.0",
    "mermaid": "^12.1.0",
    "monaco-editor": "^0.57.0",
    "motion-v": "^2.6.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "sucrase": "^3.35.1",
    "tailwindcss": "^4.3.3",
    "unist-util-visit": "^5.1.0",
    "vite": "catalog:",
    "vue": "catalog:"
  },
  "devDependencies": {
    "rolldown": "^1.2.13",
    "vue-tsc": "^3.3.13"
  }
}
