---
import HomeHero from './HomeHero.astro';
import HomeAIExamples from './HomeAIExamples.vue';
import HomePreviewGrid from './HomePreviewGrid.vue';
import HomeSection from './HomeSection.astro';
import HomeThemePreview from './HomeThemePreview.vue';
---
<div class="home-landing not-content">
  <HomeHero />
  <HomeSection id="ai-examples" title="从输入，到回答。" description="" href="/mcp/" linkLabel="接入 MCP"><HomeAIExamples client:visible /></HomeSection>
  <HomeSection id="components" title="先动手，再开始。" description="输入、选择、切换，直接试试真实组件。" href="/components/" linkLabel="全部组件"><HomePreviewGrid client:load /></HomeSection>
  <HomeSection id="theme" title="同一套组件，你的风格。" description="切换预设，查看控件与页面如何一起变化。" href="/guides/theme-editor/" linkLabel="打开主题编辑器"><HomeThemePreview client:visible /></HomeSection>
  <footer class="home-landing__footer"><span>SD Design · 为 AI 而生</span><a href="/guides/start/">把想法变成界面 →</a></footer>
</div>
<style lang="scss">
  .home-landing { max-width: 1120px; margin-inline: auto; padding-bottom: 32px; }
  :global(.main-pane) .home-landing.not-content { margin-block: 0; margin-inline: auto; }
  .home-landing__footer { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 16px; padding-block: 24px; color: var(--sd-color-text-3); font-size: 13px; border-top: 1px solid var(--sd-color-border-1); }
  .home-landing__footer a { color: var(--sd-color-text-2); text-decoration: none; }

</style>
