---
interface Props { id: string; title: string; description: string; href: string; linkLabel: string }
const { id, title, description, href, linkLabel } = Astro.props;
---
<section id={id} class="home-section" aria-labelledby={`${id}-heading`}>
  <header class="home-section__header"><div><h2 id={`${id}-heading`}>{title}</h2>{description && <p>{description}</p>}</div><a href={href}>{linkLabel} <span aria-hidden="true">↗</span></a></header>
  <slot />
</section>
<style lang="scss">
  .home-section {
    padding-block: 48px; border-top: 1px solid var(--sd-color-border-1);
    &__header { display: flex; align-items: end; justify-content: space-between; gap: 24px; margin-bottom: 28px; }
    &__header h2 { margin: 0; color: var(--sd-color-text-1); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; }
    &__header p { margin: 10px 0 0; color: var(--sd-color-text-2); font-size: 14px; line-height: 1.75; }
    &__header > a { flex-shrink: 0; color: var(--sd-color-text-2); font-size: 14px; text-decoration: none; }
    &__header > a:hover { color: rgb(var(--sd-primary-7)); }
    @media (width < 50rem) { &__header { align-items: start; flex-direction: column; gap: 12px; } }
  }
</style>
