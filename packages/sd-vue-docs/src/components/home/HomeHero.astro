---
import { docsSidebar } from '../../generated/docs-sidebar';
import HomeAIWorkbench from './HomeAIWorkbench.vue';
import HomeFramework from './HomeFramework.vue';
type Entry = { slug?: string; label: string; items?: Entry[] };
const collect = (entries: Entry[]): { label: string; href: string }[] => entries.flatMap((entry) => entry.items ? collect(entry.items) : entry.slug?.startsWith('components/') ? [{ label: entry.label, href: `/${entry.slug}/` }] : []);
const components = collect(docsSidebar);
---
<section class="home-hero" aria-labelledby="home-title">
  <div class="home-hero__copy">
    <p class="home-hero__signature" data-home-enter><img class="home-hero__mark" src="/logo-icon.png" alt="" width="24" height="24" /> SD Design <span>让智能，拥有好用的界面</span></p>
    <h1 id="home-title" data-home-enter>为 <em>AI</em> 而生。<br />从想法，到好用的界面。</h1>
    <p class="home-hero__description" data-home-enter>从一句提问，到完整的产品体验。<br class="home-hero__mobile-break" /> {components.length} 个可组合组件，让你专注创造下一种可能。</p>
    <HomeFramework client:load />
    <div class="home-hero__actions" data-home-enter>
      <a class="home-hero__primary" href="/guides/start/">开始使用 <span aria-hidden="true">↗</span></a>
      <a href="/components/">浏览组件 <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <div class="home-hero__workbench"><HomeAIWorkbench client:load /></div>
  <nav class="home-hero__shortcuts" aria-label="快速入口">
    <a href="/components/sender/">AI 对话 ↗</a><a href="/components/skeleton-reveal/">线框入场 ↗</a><a href="/guides/theme-editor/">主题编辑器 ↗</a><a href="/mcp/">接入 MCP ↗</a>
  </nav>
</section>
<script>
  import { animate, stagger } from 'motion-v';
  const elements = document.querySelectorAll<HTMLElement>('[data-home-enter]');
  if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !document.hidden) {
    const entrance = animate(elements, { opacity: [0, 1], y: [10, 0] }, { duration: 0.42, delay: stagger(0.055), ease: [0.22, 1, 0.36, 1] });
    const finish = () => { entrance.complete(); };
    const preference = matchMedia('(prefers-reduced-motion: reduce)');
    const onPreference = () => { if (preference.matches) finish(); };
    const onVisibility = () => { if (document.hidden) finish(); };
    preference.addEventListener('change', onPreference);
    document.addEventListener('visibilitychange', onVisibility);
    void entrance.then(() => { preference.removeEventListener('change', onPreference); document.removeEventListener('visibilitychange', onVisibility); });
  }
</script>
<style lang="scss">
  .home-hero {
    padding: 52px 24px 48px; text-align: center;
    &__copy { max-width: 900px; margin-inline: auto; }
    &__signature { margin: 0 0 24px; color: var(--sd-color-text-1); font-size: 14px; font-weight: 600; }
    &__signature span { margin-left: 8px; color: var(--sd-color-text-3); font-weight: 400; }
    &__signature .home-hero__mark { display: inline-block; width: 24px; height: 24px; margin: 0 6px 0 0; object-fit: contain; vertical-align: middle; }
    h1 { margin: 0; color: var(--sd-color-text-1); font-size: clamp(32px, 4.5vw, 58px); font-weight: 600; line-height: 1.3; letter-spacing: -0.035em; text-wrap: balance; }
    h1 em { color: rgb(var(--sd-primary-6)); font-style: normal; }
    &__description { margin: 24px 0 0; color: var(--sd-color-text-2); font-size: 16px; line-height: 1.8; }
    &__mobile-break { display: none; }
    &__actions { display: flex; align-items: center; justify-content: center; gap: 24px; margin-top: 28px; }
    &__actions a { display: inline-flex; align-items: center; gap: 20px; color: var(--sd-color-text-1); font-size: 14px; text-decoration: none; }
    &__actions a span { transition: transform 160ms ease-out; }
    &__actions a:hover span { transform: translate(2px, -1px); }
    &__actions .home-hero__primary { padding: 12px 18px; color: var(--sd-color-white); background: rgb(var(--sd-primary-6)); border-radius: 8px; }
    &__workbench { max-width: 1000px; margin: 36px auto 0; text-align: left; }
    &__shortcuts { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px 28px; margin-top: 24px; }
    &__shortcuts a { color: var(--sd-color-text-3); font-size: 13px; text-decoration: none; }
    &__shortcuts a:hover { color: rgb(var(--sd-primary-7)); }
    a:focus-visible { outline: 2px solid rgb(var(--sd-primary-6)); outline-offset: 4px; }
  }
  @media (width < 50rem) { .home-hero { padding: 40px 4px; } .home-hero__mobile-break { display: block; } .home-hero__shortcuts { gap: 12px 20px; } }
  @media (prefers-reduced-motion: reduce) { .home-hero__actions a span { transition: none; } }
</style>
