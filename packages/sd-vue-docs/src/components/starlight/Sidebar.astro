---
import DefaultSidebar from '@astrojs/starlight/components/Sidebar.astro';
import FrameworkSwitch from './FrameworkSwitch.vue';
import { getFrameworkLinks } from '../../utils/framework-navigation';
import manifest from '../../generated/docs-manifest.json';

const paths = new Set(manifest.flatMap(({ slug }) => [slug, `react/${slug}`.replace(/\/$/, '')]));
const { isReact, vueHref, reactHref } = getFrameworkLinks(Astro.url.pathname, paths, {
  base: import.meta.env.BASE_URL,
});
---

<FrameworkSwitch isReact={isReact} vueHref={vueHref} reactHref={reactHref} client:load />
<DefaultSidebar {...Astro.props} />
