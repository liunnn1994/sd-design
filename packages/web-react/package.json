    "test:e2e": "cypress run --browser chrome",
    "test:docs:e2e": "cypress run --browser chrome --config-file cypress.docs.config.ts",
    "build": "tsc -p tsconfig.json",
    "prepack": "pnpm run build",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc -p tests/browser/tsconfig.check.json && tsc -p tests/markdown-types/tsconfig.json && tsc -p tests/sender-types/tsconfig.json",
