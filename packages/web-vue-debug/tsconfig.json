{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@sdata/web-vue": ["../web-vue/components/index.ts"],
      "@sdata/web-vue/es/icon": ["../web-vue/components/icon/index.ts"],
      "@web-vue-src/*": ["../web-vue/components/*"]
    },
    "strict": true,
    "allowJs": false,
    "allowImportingTsExtensions": true,
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"]
  },
  "include": [
    "src/**/*",
    "vite.config.ts",
    "../web-vue/global.d.ts",
    "../web-vue/components/shims.d.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
