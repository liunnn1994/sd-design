{
  "name": "@sdata/web-vue",
  "version": "5.5.0",
  "description": "SD Design Vue: A Vue.js 3 UI Library",
  "keywords": [
    "sd",
    "vue"
  ],
  "homepage": "https://sd-design.js.org",
  "license": "AGPL-3.0-only",
  "author": "SData FE Team",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/liunnn1994/sd-design.git"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "es",
    "dist",
    "json"
  ],
  "type": "module",
  "sideEffects": [
    "dist/*",
    "es/**/style/*",
    "*.scss"
  ],
  "module": "es/index.js",
  "types": "es/index.d.ts",
  "unpkg": "dist/sd-vue.min.js",
  "exports": {
    ".": {
      "types": "./es/index.d.ts",
      "import": "./es/index.js",
      "default": "./es/index.js"
    },
    "./es/icon": {
      "types": "./es/icon/index.d.ts",
      "import": "./es/icon.js",
      "default": "./es/icon.js"
    },
    "./es/icon.js": {
      "types": "./es/icon/index.d.ts",
      "import": "./es/icon.js",
      "default": "./es/icon.js"
    },
    "./es/*": "./es/*",
    "./dist/*": "./dist/*",
    "./json/*": "./json/*",
    "./package.json": "./package.json",
    "./markstream": {
      "types": "./es/markdown-render/upstream.d.ts",
      "import": "./es/markdown-render/upstream.js"
    },
    "./markstream/utils": {
      "types": "./es/markdown-render/compat/utils.d.ts",
      "import": "./es/markdown-render/compat/utils.js"
    },
    "./markstream/utils/katex-threshold": {
      "types": "./es/markdown-render/compat/utils/katex-threshold.d.ts",
      "import": "./es/markdown-render/compat/utils/katex-threshold.js"
    },
    "./markstream/utils/performance-monitor": {
      "types": "./es/markdown-render/compat/utils/performance-monitor.d.ts",
      "import": "./es/markdown-render/compat/utils/performance-monitor.js"
    },
    "./markstream/utils/safeRaf": {
      "types": "./es/markdown-render/compat/utils/safeRaf.d.ts",
      "import": "./es/markdown-render/compat/utils/safeRaf.js"
    },
    "./markstream/tailwind": {
      "types": "./es/markdown-render/compat/tailwind.d.ts",
      "import": "./es/markdown-render/compat/tailwind.js"
    },
    "./markstream/workers/katexWorkerClient": {
      "types": "./es/markdown-render/compat/workers/katexWorkerClient.d.ts",
      "import": "./es/markdown-render/compat/workers/katexWorkerClient.js"
    },
    "./markstream/workers/mermaidWorkerClient": {
      "types": "./es/markdown-render/compat/workers/mermaidWorkerClient.d.ts",
      "import": "./es/markdown-render/compat/workers/mermaidWorkerClient.js"
    },
    "./markstream/workers/katexCdnWorker": {
      "types": "./es/markdown-render/compat/workers/katexCdnWorker.d.ts",
      "import": "./es/markdown-render/compat/workers/katexCdnWorker.js"
    },
    "./markstream/workers/mermaidCdnWorker": {
      "types": "./es/markdown-render/compat/workers/mermaidCdnWorker.d.ts",
      "import": "./es/markdown-render/compat/workers/mermaidCdnWorker.js"
    },
    "./markstream/workers/katexRenderer.worker": {
      "types": "./es/markdown-render/compat/workers/katexRenderer.worker.d.ts",
      "import": "./es/markdown-render/compat/workers/katexRenderer.worker.js"
    },
    "./markstream/workers/mermaidParser.worker": {
      "types": "./es/markdown-render/compat/workers/mermaidParser.worker.d.ts",
      "import": "./es/markdown-render/compat/workers/mermaidParser.worker.js"
    },
    "./markstream/index.css": "./es/markdown-render/style/upstream.css",
    "./markstream/index.px.css": "./es/markdown-render/style/index.px.css",
    "./markstream/index.tailwind.css": "./es/markdown-render/style/index.tailwind.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "style:sync": "node ./scripts/sync-markstream-style.ts",
    "theme:generate": "node ./scripts/theme-catalog.ts",
    "test:theme": "node --test ./scripts/theme-catalog.test.ts && cypress run --quiet --component --browser chrome --spec components/config-provider/__test__/*.cy.ts",
    "test:theme:e2e": "cypress run --quiet --browser chrome --config-file cypress.theme.config.ts",
    "predev": "pnpm run style:sync && pnpm run icongen",
    "dev": "vp run task:dev-component",
    "start": "pnpm run dev",
    "icongen": "pnpm run theme:generate && vp run gen:icons",
    "jsongen": "vp run gen:web-types",
    "build": "pnpm run build:component && pnpm run build:style && pnpm run build:dts && pnpm run jsongen",
    "prebuild:component": "pnpm run icongen",
    "build:component": "vp run task:build-component",
    "prebuild:module": "pnpm run icongen",
    "build:module": "vp run task:build-module",
    "prebuild:style": "pnpm run style:sync && pnpm run theme:generate",
    "build:style": "vp run task:build-style",
    "prebuild:dts": "pnpm run icongen",
    "build:dts": "node ./scripts/build-dts.ts",
    "dtsgen": "pnpm run build:dts",
    "pretypecheck": "pnpm run icongen",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "pretest": "pnpm run icongen",
    "test": "pnpm run test:markdown:types && pnpm run test:model-selector:production && cypress run --quiet --component --browser chrome",
    "test:model-selector:production": "node --test ./scripts/model-selector-trigger-element.test.ts",
    "test:affected": "node ./scripts/find-affected-cypress-specs.ts",
    "test:affected:unit": "node --test ./scripts/find-affected-cypress-specs.test.ts",
    "test:headed": "cypress run --quiet --component --browser chrome --headed",
    "cypress:open": "cypress open --component",
    "cypress:run": "cypress run --quiet --component --browser chrome",
    "test:markdown:e2e": "cypress run --quiet --browser chrome --config-file cypress.markdown.config.ts",
    "test:markdown:types": "node --test ./scripts/markdown-exports.test.ts"
  },
  "dependencies": {
    "@arco-design/color": "^0.4.0",
    "@chenglou/pretext": "^0.0.9",
    "@floating-ui/vue": "^2.0.1",
    "@lexical/code": "^0.52.0",
    "@lexical/history": "^0.52.0",
    "@lexical/html": "^0.52.0",
    "@lexical/link": "^0.52.0",
    "@lexical/list": "^0.52.0",
    "@lexical/markdown": "^0.52.0",
    "@lexical/rich-text": "^0.52.0",
    "@videojs/html": "10.0.0-rc.2",
    "b-tween": "^0.3.3",
    "b-validate": "^1.5.3",
    "chroma-js": "^3.2.0",
    "compute-scroll-into-view": "^3.1.1",
    "copy-to-clipboard": "^4.0.2",
    "cropperjs": "^2.2.0",
    "dayjs": "^1.11.23",
    "es-toolkit": "catalog:",
    "lexical": "^0.52.0",
    "markstream-vue": "2.0.13",
    "motion-v": "^2.4.4",
    "number-precision": "^1.6.0",
    "overlayscrollbars": "^2.16.0",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "recorder-core": "^1.3.26070800",
    "resize-observer-polyfill": "^1.5.1",
    "scroll-into-view-if-needed": "^3.1.0",
    "virtua": "^0.52.5",
    "vue": "catalog:",
    "vue-clamp": "^1.7.1",
    "vue-component-type-helpers": "3.3.11",
    "vue-draggable-plus": "^0.6.1"
  },
  "devDependencies": {
    "@babel/types": "^8.0.6",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/chroma-js": "3.1.2",
    "@types/clean-css": "^4.2.11",
    "@types/qrcode": "^1.5.6",
    "@vitejs/plugin-vue": "catalog:",
    "@vitejs/plugin-vue-jsx": "catalog:",
    "@vue/test-utils": "^2.5.1",
    "@vueuse/core": "catalog:",
    "clean-css": "^5.3.3",
    "cypress": "16.1.0",
    "fast-glob": "^3.3.3",
    "glob": "^13.0.6",
    "sass": "^1.104.1",
    "semantic-release": "^25.0.9",
    "svgo": "^4.1.0",
    "type-fest": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vue-docgen-api": "4.79.2",
    "vue-tsc": "^3.3.11"
  },
  "peerDependencies": {
    "vue": "catalog:"
  },
  "vetur": {
    "tags": "json/vetur-tags.json",
    "attributes": "json/vetur-attributes.json"
  },
  "web-types": "json/web-types.json"
}
