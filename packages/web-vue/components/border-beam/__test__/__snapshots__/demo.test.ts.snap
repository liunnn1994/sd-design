  <div class="sd-space-item">
    <div style="padding: 24px; background: rgb(13, 13, 26); border-radius: 16px;">
      <div data-beam="bb-27" data-active="" class="sd-border-beam" style="--beam-strength: 1; --beam-density: 1;">
        <div style="padding: 22px 28px; background: rgb(26, 26, 46); border-radius: 16px; color: rgb(224, 224, 224); min-width: 300px;">
          <div style="font-size: 15px; font-weight: 600; margin-bottom: 12px;"> 深色背景 · 动画状态: 激活</div><button class="sd-btn sd-btn-primary sd-btn-shape-square sd-btn-size-small sd-btn-status-normal" type="button">
