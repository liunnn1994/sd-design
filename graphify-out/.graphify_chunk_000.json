      "author": null,
      "contributor": null,
      "rationale": "Root scripts intentionally kept minimal and unified, emphasizing stable collaboration and predictable workflows over distributed build tooling."
    },
    {
      "id": "vendor_bridge_layer",
      "label": "Vendor Bridge Layer (sync-vendor.mjs)",
      "file_type": "concept",
      "source_file": "ARCHITECTURE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Exists to isolate component source/build output from the documentation site's browser runtime. Online editors, browser-side module loading, and style drift issues all trace back to this layer."
    },
    {
      "id": "theme_bridge_system",
      "label": "Theme Bridge System",
      "file_type": "concept",
      "source_file": "ARCHITECTURE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Site theme and component library theme do not share runtime state natively; they are explicitly synced via a bridge script. Dark mode or floating layer inconsistencies indicate a sync issue."
    },
    {
      "id": "build_pipeline",
      "label": "Component Build Pipeline",
      "file_type": "concept",
      "source_file": "ARCHITECTURE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Build stages are sequential: icon generation -> ES Module -> UMD -> Style -> DTS -> IDE metadata. Troubleshooting should identify which stage failed rather than treating build as monolithic."
    },
    {
      "id": "quality_gate",
      "label": "Quality Gate (check/check:ci/release:check)",
      "file_type": "concept",
      "source_file": "ARCHITECTURE.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "All changes destined for main branch or release must pass root-level unified validation, not just single-package checks, to prevent cross-package integration regressions."
