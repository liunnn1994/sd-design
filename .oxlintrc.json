{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {},
  "env": { "builtin": true },
  "ignorePatterns": [
    "*.json",
    "*.js",
    "packages/web-vue/components/icon/*",
    "packages/web-vue/dist/*",
    "packages/web-vue/es/*",
    "packages/web-vue/lib/*",
    "packages/web-vue/*.json",
    "packages/web-vue/*.js",
    "vendor/**",
    "skills/**",
    "packages/sd-vue-docs/.astro/**",
    ".*/"
  ],
  "plugins": ["typescript"],
  "rules": { "typescript/no-explicit-any": "error" },
  "overrides": [
    {
      "files": [
        "packages/web-vue/**/*.js",
        "packages/web-vue/**/*.jsx",
        "packages/web-vue/**/*.cjs",
        "packages/web-vue/**/*.mjs",
        "packages/web-vue/**/*.ts",
        "packages/web-vue/**/*.tsx",
        "packages/web-vue/**/*.cts",
        "packages/web-vue/**/*.mts",
        "packages/web-vue/**/*.vue"
      ],
      "env": { "browser": true, "node": true },
      "plugins": ["typescript", "import", "vue"],
      "rules": {
        "import/extensions": [
          "error",
          "ignorePackages",
          { "js": "never", "jsx": "never", "ts": "never", "tsx": "never" }
        ],
        "prefer-template": "error",
        "no-empty": ["error", { "allowEmptyCatch": true }],
        "no-unused-expressions": ["error", { "allowShortCircuit": true, "allowTernary": true }],
        "no-console": "error",
        "no-unused-vars": "error"
      }
    },
    {
      "files": [
        "scripts/**/*.ts",
        "packages/*/scripts/**/*.{ts,mts}",
        "packages/*/release.config.ts"
      ],
      "plugins": ["import", "typescript"],
      "rules": { "import/extensions": "off", "no-console": "off" }
    },
    {
      "files": ["packages/*/vite.config.ts", "packages/*/astro.config.ts"],
      "plugins": ["import", "typescript"],
      "rules": { "import/extensions": "off" }
    },
    {
      "files": [
        "packages/web-vue/components/calendar/core/**/*.ts",
        "packages/web-vue/components/calendar/modules/drag-and-drop.ts",
        "packages/web-vue/components/calendar/utils/date.ts"
      ],
      "rules": { "no-console": "off" }
    },
    {
      "files": ["packages/web-vue/**/*.vue"],
      "plugins": ["vue"],
      "rules": {
        "vue/no-reserved-component-names": [
          "error",
          {
            // 严格区分大小写
            // @see https://oxc.rs/docs/guide/usage/linter/rules/vue/no-reserved-component-names.html#htmlelementcasesensitive
            "htmlElementCaseSensitive": true
          }
        ]
      }
    }
  ]
}
