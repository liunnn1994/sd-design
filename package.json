{
  "name": "sd-design-vue-monorepo",
  "private": true,
  "description": "SD Design Vue Monorepo",
  "license": "AGPL-3.0-only",
  "author": "SData FE Team",
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "cz": "czg",
    "simple-git-hooks": "simple-git-hooks",
    "prepare": "run-s simple-git-hooks",
    "dev": "vp run dev:all",
    "dev:web-vue": "pnpm --filter @sd-design/web-vue-debug dev",
    "dev:color-picker-debug": "pnpm run dev:web-vue",
    "dev:all": "pnpm --filter @sdata/web-vue run build:module && pnpm --filter @sdata/web-vue run build:dts && pnpm --filter @sdata/web-vue run jsongen && pnpm --filter @sdata/web-react build && pnpm --filter @sd-design/sd-vue-docs run docs:vendor:only && vp run --parallel --filter @sdata/web-vue --filter @sd-design/sd-vue-docs dev:serve",
    "dev:component": "vp run --filter @sdata/web-vue dev",
    "dev:docs": "vp run --filter @sd-design/sd-vue-docs dev",
    "build": "vp run build:all",
    "build:all": "pnpm --filter @sdata/web-vue run build && pnpm --filter @sdata/web-react build && pnpm --filter @sd-design/sd-vue-docs run docs:vendor:only && pnpm --filter @sd-design/sd-vue-docs run build:site:prepared",
    "build:docs": "vp run --filter @sd-design/sd-vue-docs build",
    "build:component": "vp run --filter @sdata/web-vue build",
    "format": "oxfmt .",
    "format:all": "pnpm run format",
    "format:check": "oxfmt --check .",
    "clean": "pnpm -r exec rimraf dist node_modules",
    "lint": "pnpm run lint:all",
    "lint:all": "run-s lint:code stylelint:fix",
    "lint:code": "oxlint .",
    "lint:ci": "pnpm run lint:all",
    "lint:fix": "oxlint . --fix",
    "typecheck": "run-s typecheck:prepare typecheck:source typecheck:scripts typecheck:vue typecheck:packages",
    "typecheck:prepare": "pnpm --filter @sdata/web-react... run build && pnpm --filter @sdata/web-vue run icongen",
    "typecheck:vue": "run-s typecheck:vue:web-vue typecheck:vue:web-vue-debug typecheck:vue:docs",
    "typecheck:vue:web-vue": "pnpm --filter @sdata/web-vue run typecheck",
    "typecheck:vue:web-vue-debug": "pnpm --filter @sd-design/web-vue-debug run typecheck",
    "typecheck:vue:docs": "pnpm --filter @sd-design/sd-vue-docs run typecheck",
    "stylelint:fix": "stylelint --fix \"packages/**/*.{css,scss,sass,less,vue}\"",
    "check": "vp run check:local",
    "check:local": "vp run lint && pnpm run typecheck && vp run test",
    "check:ci": "vp run format:check && vp run lint:ci && pnpm run typecheck && vp run test:ci && vp run build:ci",
    "test": "vp run test:component",
    "test:component": "pnpm run test:foundations && pnpm --filter @sdata/web-react test && vp run --filter @sdata/web-vue test",
    "test:headed": "vp run --filter @sdata/web-vue test:headed",
    "test:ci": "vp run test:component",
    "test:all": "vp run test:component",
    "format:readme": "oxfmt README.md",
    "format:pkg": "oxfmt package.json",
    "install:deps": "pnpm i",
    "install:ci": "pnpm install --frozen-lockfile",
    "build:ci": "vp run build:all",
    "release:check": "pnpm run check:ci",
    "upgrade:all": "run-s upgrade:audit upgrade:deps upgrade:engines upgrade:browserslist upgrade:skills format:readme format:pkg install:deps upgrade:oxlint",
    "upgrade:browserslist": "node scripts/upgradeBrowserslist.ts",
    "upgrade:deps": "pnpm update -w -L && pnpm update -r -L",
    "upgrade:skills": "pnpx skills update -p -a codex -a claude-code",
    "upgrade:engines": "node scripts/upgradeEngines.ts",
    "upgrade:oxlint": "node scripts/upgradeOxlint.ts",
    "upgrade:audit": "pnpm audit --fix override --registry=https://registry.npmjs.org",
    "clone:vendor": "node scripts/cloneVendor.ts",
    "lint-staged": "lint-staged --max-arg-length 6000 --concurrent false",
    "commitlint": "commitlint",
    "typecheck:scripts": "tsc -p tsconfig.scripts.json",
    "typecheck:packages": "pnpm --filter @sdata/web-react run typecheck && pnpm --filter @sdata/web-vue-mcp run typecheck && pnpm --filter @sdata/web-vue-auto-import-resolver run typecheck",
    "typecheck:source": "node packages/web-vue/scripts/check-typescript-sources.ts",
    "build:core": "pnpm --filter @sdata/web-core run build",
    "test:core": "pnpm --filter @sdata/web-core test",
    "typecheck:core": "pnpm --filter @sdata/web-core run typecheck",
    "test:type-references": "node --test packages/sd-vue-docs/scripts/build-type-reference-manifest.test.ts",
    "test:styles": "node --test packages/web-vue/scripts/shared-style-contract.test.ts packages/web-vue/scripts/theme-catalog.test.ts packages/web-vue/scripts/theme-palette.test.ts",
    "test:docs-dev": "pnpm --filter @sd-design/sd-vue-docs run test:dev",
    "test:foundations": "run-s test:core test:styles test:type-references test:docs-dev"
  },
  "dependencies": {
    "es-toolkit": "catalog:",
    "type-fest": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/node": "~26.6.7",
    "axios": "^1.21.1",
    "confbox": "^0.3.2",
    "czg": "^1.14.0",
    "enhanced-resolve": "5.27.0",
    "fast-glob": "^3.3.3",
    "htmlparser2": "12.0.0",
    "lint-staged": "^17.6.1",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "postcss-html": "^2.0.1",
    "postcss-less": "^7.1.1",
    "postcss-scss": "^4.0.9",
    "rimraf": "^6.1.4",
    "simple-git-hooks": "^2.14.0",
    "stylelint": "^18.0.0",
    "stylelint-config-rational-order": "^0.1.2",
    "stylelint-config-recommended-vue": "^2.0.0",
    "stylelint-config-standard": "^41.0.0",
    "stylelint-order": "^8.1.3",
    "stylelint-scss": "^7.5.0",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm run lint-staged",
    "commit-msg": "pnpm run commitlint -e",
    "pre-push": "pnpm run typecheck"
  },
  "engines": {
    "node": "~26.13.1"
  }
}
